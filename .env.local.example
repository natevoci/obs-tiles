# YouTube Live — bundled OAuth credentials
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and will never be committed.
#
# These values are injected at build time by Vite (VITE_ prefix required).
# When set, the YouTube Settings panel shows a simple "Sign in" button with
# no GCP project setup required for end users.
#
# Create a GCP project + Desktop app OAuth credential:
#   https://console.cloud.google.com
#   → APIs & Services → Credentials → Create Credentials → OAuth client ID
#   → Application type: Desktop app
# Then publish the OAuth consent screen (In production) to avoid 7-day token expiry.

VITE_YOUTUBE_CLIENT_ID=your-client-id-here
VITE_YOUTUBE_CLIENT_SECRET=your-client-secret-here
